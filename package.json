{
  "name": "qds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Quieto Design System — design tokens, web components, and documentation.",
  "license": "MIT",
  "author": "Dillon Schultz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dillonschultz93/qds.git"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "validate": "turbo validate",
    "analyze": "turbo analyze",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.8",
    "typescript": "5.9.3"
  }
}
