{#
  A published package's name and version, where to get it, and how to install
  it. Expects `pkg`, from _data/packages.js.
#}
<div class="package-links">
  <p class="package-links__name">
    <code>{{ pkg.name }}</code>
    <qds-chip>{{ pkg.version }}</qds-chip>
  </p>
  <ul class="package-links__list">
    <li><a href="{{ pkg.npm }}" rel="noopener">npm</a></li>
    <li><a href="{{ pkg.source }}" rel="noopener">Source on GitHub</a></li>
    <li><a href="{{ pkg.changelog }}" rel="noopener">Changelog</a></li>
  </ul>
  <pre class="package-links__install"><code>npm install {{ pkg.name }}</code></pre>
</div>
