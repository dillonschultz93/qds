<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.shortTitle }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />

    {#
      The theme must be resolved BEFORE first paint, or a reader whose stored
      preference is dark sees a white flash while the stylesheet and script load.
      Inline and synchronous in the head is the only place that works.
    #}
    <script>
      (function () {
        try {
          var stored = localStorage.getItem('qds-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch (error) {
          /* Private mode: fall back to prefers-color-scheme. */
        }
      })();
    </script>

    {# The token stylesheet, loaded once at document level. Custom properties
       inherit through shadow DOM, so every component picks these up. #}
    <link rel="stylesheet" href="/assets/qds.css" />
    <link rel="stylesheet" href="/assets/docs.css" />

    <script type="module" src="/assets/ui.js"></script>
    <script type="module" src="/assets/theme-toggle.js"></script>
    <script type="module" src="/assets/search.js"></script>
    <script type="module" src="/assets/page-contents.js"></script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {% set section = docs.sections | sectionFor(page.url) %}

    <header class="site-header">
      <a class="site-header__brand" href="/">{{ site.shortTitle }}</a>

      <nav class="site-nav" aria-label="Main">
        <ul>
          {% for item in docs.sections %}
            <li>
              <a
                href="{{ item.url }}"
                {% if page.url == item.url %}aria-current="page"{% elif section and section.key == item.key %}aria-current="true"{% endif %}
              >{{ item.title }}</a>
            </li>
          {% endfor %}
          <li>
            <a href="/roadmap/"{% if page.url == '/roadmap/' %} aria-current="page"{% endif %}>Roadmap</a>
          </li>
        </ul>
      </nav>

      <div class="site-header__actions">
        {# Hidden until search.js loads: without it the button would do nothing. #}
        <button
          id="search-open"
          class="search-button"
          type="button"
          aria-keyshortcuts="/ Control+K Meta+K"
          hidden
        >Search <kbd>/</kbd></button>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-live="polite"
        >Theme</button>
        <a href="{{ site.repo }}" rel="noopener">GitHub</a>
      </div>
    </header>

    {#
      Three columns where there is room: the section's pages, the content, and
      the page's own contents. The contents list is filled in at build time from
      the page's h2s (see the page-contents transform in eleventy.config.js), and
      dropped when there are fewer than two.
    #}
    <div class="page{% if section %} page--sectioned{% endif %}{% if wide %} page--wide{% endif %}">
      {% if section %}{% include "partials/sidebar.njk" %}{% endif %}

      <main id="main" class="prose">
        {% if title and not hideTitle %}<h1>{{ title }}</h1>{% endif %}
        {% if description and not hideTitle %}<p class="lede">{{ description }}</p>{% endif %}
        {{ content | safe }}
      </main>

      {% if toc != false %}<!-- page-contents -->{% endif %}
    </div>

    <qds-modal id="search" heading="Search the docs" light-dismiss>
      <div class="search">
        <input
          id="search-input"
          class="search__input"
          type="search"
          role="combobox"
          aria-label="Search the docs"
          aria-expanded="false"
          aria-controls="search-results"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          placeholder="Components, properties, tokens…"
        />
        <p id="search-status" class="search__status" role="status"></p>
        <ul id="search-results" class="search__results" role="listbox" aria-label="Results"></ul>
      </div>
    </qds-modal>

    <footer class="site-footer">
      <nav class="site-footer__columns" aria-label="Footer">
        <div>
          <h2 class="site-footer__heading">Docs</h2>
          <ul>
            {% for item in docs.sections %}{% if item.key != 'ai' %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endif %}{% endfor %}
            <li><a href="/roadmap/">Roadmap</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">AI</h2>
          <ul>
            {% for item in (docs.sections | sectionFor('/ai/')).groups[0].pages %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">Packages</h2>
          <ul>
            {% for key in ['ui', 'tokens', 'skills'] %}<li><a href="{{ packages[key].npm }}" rel="noopener">{{ packages[key].name }}</a></li>{% endfor %}
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">Project</h2>
          <ul>
            <li><a href="{{ site.repo }}" rel="noopener">GitHub</a></li>
            <li><a href="{{ site.repo }}/issues" rel="noopener">Report an issue</a></li>
            <li><a href="{{ site.repo }}/blob/main/LICENSE" rel="noopener">MIT license</a></li>
          </ul>
        </div>
      </nav>
    </footer>
  </body>
</html>
