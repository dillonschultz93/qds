<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {#
      Search and social metadata. Titles end with the full name, which is what
      people search for; the home page gets a title that says what the site is.
      URLs are absolute (site.url), as canonical and Open Graph require. A page
      opts out of indexing with `noindex: true` in its front matter.
    #}
    {%- set isHome = page.url == '/' %}
    {%- set fullTitle = (site.title + ': ' + site.tagline) if isHome else ((title + ' · ' + site.title) if title else site.title) %}
    {%- set metaDescription = description or site.description %}
    {%- set canonical = site.url + page.url %}
    {#- The home and 404 pages share the designed card; every other page has its own, written by og-images.js. #}
    {%- set pageCard = not isHome and not noindex %}
    {%- set ogImageUrl = site.url + ((page.url | ogImage) if pageCard else site.ogImage.path) %}
    {%- set ogImageAlt = (title + ' · ' + site.title + ': ' + metaDescription) if pageCard else site.ogImage.alt %}
    <title>{{ fullTitle }}</title>
    <meta name="description" content="{{ metaDescription }}" />
    {%- if noindex %}<meta name="robots" content="noindex" />{% else %}<link rel="canonical" href="{{ canonical }}" />{% endif %}

    {% if site.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.googleSiteVerification }}" />{% endif %}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="{{ fullTitle }}" />
    <meta property="og:description" content="{{ metaDescription }}" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:image" content="{{ ogImageUrl }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ ogImageAlt }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ fullTitle }}" />
    <meta name="twitter:description" content="{{ metaDescription }}" />
    <meta name="twitter:image" content="{{ ogImageUrl }}" />
    <meta name="twitter:image:alt" content="{{ ogImageAlt }}" />

    {# Structured data: the site itself on the home page, and a breadcrumb trail on section pages. #}
    {%- set crumbSection = docs.sections | sectionFor(page.url) %}
    {%- if isHome %}
      <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.title,
        alternateName: site.shortTitle,
        url: site.url + '/',
        description: site.description
      } | dump | safe }}</script>
    {%- elif crumbSection and not noindex %}
      {%- set homeCrumb = { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' } %}
      {%- set sectionCrumb = { '@type': 'ListItem', position: 2, name: crumbSection.title, item: site.url + crumbSection.url } %}
      {%- if page.url == crumbSection.url %}
        {%- set crumbs = [homeCrumb, sectionCrumb] %}
      {%- else %}
        {%- set crumbs = [homeCrumb, sectionCrumb, { '@type': 'ListItem', position: 3, name: title, item: canonical }] %}
      {%- endif %}
      <script type="application/ld+json">{{ { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs } | dump | safe }}</script>
    {%- endif %}
    {# The Quieto mark. The SVG switches to a lighter blue in a dark browser theme; the PNGs are fallbacks. #}
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    {#
      The theme must be resolved BEFORE first paint, or a reader whose stored
      preference is dark sees a white flash while the stylesheet and script load.
      Inline and synchronous in the head is the only place that works. The root
      ships data-theme="light", so light is the default and the OS setting is
      ignored; this only switches to a stored dark.
    #}
    <script>
      (function () {
        try {
          if (localStorage.getItem('qds-theme') === 'dark') {
            document.documentElement.dataset.theme = 'dark';
          }
        } catch (error) {
          /* Private mode: stay light. */
        }
      })();
    </script>

    {# The token stylesheet, loaded once at document level. Custom properties
       inherit through shadow DOM, so every component picks these up. #}
    <link rel="stylesheet" href="/assets/qds.css" />
    <link rel="stylesheet" href="/assets/docs.css" />

    <script type="module" src="/assets/ui.js"></script>
    <script type="module" src="/assets/theme-toggle.js"></script>
    <script type="module" src="/assets/search.js"></script>
    <script type="module" src="/assets/page-contents.js"></script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {% set section = docs.sections | sectionFor(page.url) %}

    <header class="site-header">
      <a class="site-header__brand" href="/" aria-label="{{ site.title }}, home">{% include "partials/logo.svg.njk" %}</a>

      <nav class="site-nav" aria-label="Main">
        <ul>
          {% for item in docs.sections %}
            <li>
              <a
                href="{{ item.url }}"
                {% if page.url == item.url %}aria-current="page"{% elif section and section.key == item.key %}aria-current="true"{% endif %}
              >{{ item.title }}</a>
            </li>
          {% endfor %}
          <li>
            <a href="/roadmap/"{% if page.url == '/roadmap/' %} aria-current="page"{% endif %}>Roadmap</a>
          </li>
        </ul>
      </nav>

      <div class="site-header__actions">
        {# Hidden until search.js loads: without it the button would do nothing. #}
        <button
          id="search-open"
          class="search-button"
          type="button"
          aria-keyshortcuts="/ Control+K Meta+K"
          hidden
        >Search <kbd>/</kbd></button>
        {# Hidden until theme-toggle.js loads; the tooltip names it, and aria-pressed says whether dark is on. #}
        <qds-tooltip text="Dark theme" placement="bottom">
          <button id="theme-toggle" class="icon-link" type="button" aria-pressed="false" hidden><qds-icon name="moon"></qds-icon></button>
        </qds-tooltip>
        {# Icon-only; the tooltip's text becomes the link's name. The icon is registered by link-icons.js. #}
        <qds-tooltip text="QDS on GitHub" placement="bottom">
          <a class="icon-link" href="{{ site.repo }}" rel="noopener"><qds-icon name="github"></qds-icon></a>
        </qds-tooltip>
      </div>
    </header>

    {#
      Three columns where there is room: the section's pages, the content, and
      the page's own contents. The contents list is filled in at build time from
      the page's h2s (see the page-contents transform in eleventy.config.js), and
      dropped when there are fewer than two.
    #}
    <div class="page{% if section %} page--sectioned{% endif %}{% if wide %} page--wide{% endif %}">
      {% if section %}{% include "partials/sidebar.njk" %}{% endif %}

      <main id="main" class="prose">
        {% if title and not hideTitle %}<h1>{{ title }}</h1>{% endif %}
        {% if description and not hideTitle %}<p class="lede">{{ description }}</p>{% endif %}
        {{ content | safe }}
      </main>

      {% if toc != false %}<!-- page-contents -->{% endif %}
    </div>

    <qds-modal id="search" heading="Search the docs" light-dismiss>
      <div class="search">
        <input
          id="search-input"
          class="search__input"
          type="search"
          role="combobox"
          aria-label="Search the docs"
          aria-expanded="false"
          aria-controls="search-results"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          placeholder="Components, properties, tokens…"
        />
        <p id="search-status" class="search__status" role="status"></p>
        <ul id="search-results" class="search__results" role="listbox" aria-label="Results"></ul>
      </div>
    </qds-modal>

    <footer class="site-footer">
      <nav class="site-footer__columns" aria-label="Footer">
        <div>
          <h2 class="site-footer__heading">Docs</h2>
          <ul>
            {% for item in docs.sections %}{% if item.key != 'ai' %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endif %}{% endfor %}
            <li><a href="/roadmap/">Roadmap</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">AI</h2>
          <ul>
            {% for item in (docs.sections | sectionFor('/ai/')).groups[0].pages %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">Packages</h2>
          <ul>
            {% for key in ['ui', 'tokens', 'skills'] %}<li><a href="{{ packages[key].npm }}" rel="noopener">{{ packages[key].name }}</a></li>{% endfor %}
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">Figma</h2>
          <ul>
            <li><a href="{{ site.figma.tokens }}" rel="noopener">Quieto Tokens</a></li>
            <li><a href="{{ site.figma.components }}" rel="noopener">Quieto Components</a></li>
            <li><a href="{{ site.figma.profile }}" rel="noopener">Figma Community</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">Project</h2>
          <ul>
            <li><a href="{{ site.repo }}" rel="noopener">GitHub</a></li>
            <li><a href="{{ site.repo }}/issues" rel="noopener">Report an issue</a></li>
            <li><a href="{{ site.repo }}/blob/main/LICENSE" rel="noopener">MIT license</a></li>
          </ul>
        </div>
      </nav>
    </footer>
  </body>
</html>
