<section class="hero">
  <h1 class="hero__title">Quieto Design System</h1>
  <p class="hero__lede">
    Design tokens and web components that share one source of truth. Every color,
    space, and type style is a token; every component is styled by nothing else.
  </p>
  <qds-stack direction="inline" gap="300" wrap>
    <a class="hero__action hero__action--primary" href="/components/">Browse components</a>
    <a class="hero__action" href="/foundations/tokens/">Read about tokens</a>
  </qds-stack>
</section>

<ul class="card-grid card-grid--sections">
  {% for section in docs.sections %}
    <li>
      <qds-card class="link-card" variant="elevated">
        <h2 slot="header"><a href="{{ section.url }}">{{ section.title }}</a></h2>
        <p>{{ section.summary }}</p>
        <p slot="footer" class="link-card__meta">
          {% if section.key == 'foundations' %}
            {{ tokens.stats.total }} tokens in three tiers
          {% elif section.key == 'styles' %}
            Color, typography, and icons
          {% else %}
            {{ docs.families | length }} components
          {% endif %}
        </p>
      </qds-card>
    </li>
  {% endfor %}
</ul>

<h2>Built from its own parts</h2>

<p>
  This site is the system's first consumer. Its pages are laid out with
  <code>qds-stack</code> and <code>qds-card</code>, search is a
  <code>qds-modal</code>, the token reference is a <code>qds-tabs</code> with a
  <code>qds-input</code> filter, and every color comes from a semantic token —
  so if a token is wrong, these pages show it. Try the theme toggle.
</p>

{% example "A few of the components" %}
  <qds-stack gap="400">
    <qds-stack direction="inline" gap="200" align="center" wrap>
      <qds-button>Save</qds-button>
      <qds-button variant="secondary">Cancel</qds-button>
      <qds-chip variant="success">Published</qds-chip>
      <qds-toggle checked>Notifications</qds-toggle>
    </qds-stack>
    <qds-progress-bar label="Upload progress" value="64"></qds-progress-bar>
  </qds-stack>
{% endexample %}

<h2>Install</h2>

<pre><code>npm install @quieto/ui</code></pre>

<p>Load the tokens once, at the top of your app, then register the components:</p>

<pre><code>import '@quieto/design-tokens/css';
import '@quieto/ui';</code></pre>

<p>
  <code>@quieto/design-tokens</code> comes with <code>@quieto/ui</code>. Without its
  stylesheet the components still render, from fallbacks built into each one, but
  nothing follows the theme.
</p>
