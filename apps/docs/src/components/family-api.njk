---
layout: layouts/base.njk
pagination:
  data: docs.families
  size: 1
  alias: family
  addAllPagesToCollections: true
permalink: "{{ family.apiUrl }}"
eleventyComputed:
  title: "{{ family.name }} API"
  description: "Every property, slot, event, CSS part, and token of {{ family.name | lower }}, read from the custom elements manifest."
---

{#
  A component's API: one section per element in the family, every table read
  from custom-elements.json so it cannot disagree with the code. Each section's
  ids are prefixed with its element (qds-tab-properties), so they stay unique
  when a family has several elements, and search can link to each.
#}

{% include "partials/component-header.njk" %}

{% for member in family.members %}
  <h2 id="{{ member.tagName }}"><code>&lt;{{ member.tagName }}&gt;</code></h2>

  <p>{{ member.description | paragraphs | first }}</p>

  <h3 id="{{ member.tagName }}-properties">Properties</h3>

  {% if member.properties | length %}
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Property</th>
            <th scope="col">Attribute</th>
            <th scope="col">Type</th>
            <th scope="col">Default</th>
            <th scope="col">Description</th>
          </tr>
        </thead>
        <tbody>
          {% for property in member.properties %}
            <tr>
              <th scope="row"><code>{{ property.name }}</code></th>
              <td>{% if property.attribute %}<code>{{ property.attribute }}</code>{% else %}—{% endif %}</td>
              <td><code>{{ property.type }}</code></td>
              <td>{% if property.default %}<code>{{ property.default }}</code>{% else %}—{% endif %}</td>
              <td>{{ property.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p>None.</p>
  {% endif %}

  <h3 id="{{ member.tagName }}-slots">Slots</h3>

  {% if member.slots | length %}
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Slot</th>
            <th scope="col">Description</th>
          </tr>
        </thead>
        <tbody>
          {% for slot in member.slots %}
            <tr>
              <th scope="row"><code>{{ slot.name }}</code></th>
              <td>{{ slot.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p>None.</p>
  {% endif %}

  {% if member.events | length %}
    <h3 id="{{ member.tagName }}-events">Events</h3>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Event</th>
            <th scope="col">Type</th>
            <th scope="col">Description</th>
          </tr>
        </thead>
        <tbody>
          {% for event in member.events %}
            <tr>
              <th scope="row"><code>{{ event.name }}</code></th>
              <td><code>{{ event.type }}</code></td>
              <td>{{ event.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if member.cssProperties | length %}
    <h3 id="{{ member.tagName }}-tokens">CSS custom properties</h3>
    <p>
      The patterns of component tokens this element reads. Every one, with its
      values, is on the <a href="{{ family.tokensUrl }}">Tokens</a> tab; overriding
      one is the supported way to restyle the component.
    </p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Property</th>
            <th scope="col">Description</th>
          </tr>
        </thead>
        <tbody>
          {% for property in member.cssProperties %}
            <tr>
              <th scope="row" class="token-name">{{ property.name }}</th>
              <td>{{ property.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if member.cssParts | length %}
    <h3 id="{{ member.tagName }}-css-parts">CSS parts</h3>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Part</th>
            <th scope="col">Description</th>
          </tr>
        </thead>
        <tbody>
          {% for part in member.cssParts %}
            <tr>
              <th scope="row"><code>{{ part.name }}</code></th>
              <td>{{ part.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  <p><small>Source: <code>packages/ui/{{ member.path }}</code></small></p>
{% endfor %}
