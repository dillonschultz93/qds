{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    // Browser-only package: no ambient Node types, so an accidental `process` or
    // `Buffer` reference fails to compile rather than shipping to a browser.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
