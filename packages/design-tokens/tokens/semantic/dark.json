{
  "color": {
    "background": {
      "default": { "$value": "{color.neutral.950}", "$type": "color" },
      "subtle": { "$value": "{color.neutral.900}", "$type": "color" },
      "neutral": { "$value": "{color.neutral.800}", "$type": "color" },
      "primary": {
        "rest": { "$value": "{color.blue.500}", "$type": "color" },
        "hover": { "$value": "{color.blue.400}", "$type": "color" },
        "active": { "$value": "{color.blue.300}", "$type": "color" },
        "disabled": { "$value": "{color.neutral.800}", "$type": "color" }
      },
      "secondary": {
        "rest": { "$value": "{color.neutral.800}", "$type": "color" },
        "hover": { "$value": "{color.neutral.700}", "$type": "color" },
        "active": { "$value": "{color.neutral.600}", "$type": "color" },
        "disabled": { "$value": "{color.neutral.900}", "$type": "color" }
      },
      "danger": {
        "rest": { "$value": "{color.red.500}", "$type": "color" },
        "hover": { "$value": "{color.red.400}", "$type": "color" },
        "active": { "$value": "{color.red.300}", "$type": "color" },
        "disabled": { "$value": "{color.neutral.800}", "$type": "color" }
      },
      "success": { "$value": "{color.green.900}", "$type": "color" },
      "warning": { "$value": "{color.yellow.900}", "$type": "color" },
      "info": { "$value": "{color.blue.900}", "$type": "color" }
    },
    "content": {
      "default": { "$value": "{color.neutral.50}", "$type": "color" },
      "subtle": { "$value": "{color.neutral.400}", "$type": "color" },
      "primary": {
        "rest": { "$value": "{color.blue.300}", "$type": "color" },
        "hover": { "$value": "{color.blue.200}", "$type": "color" },
        "visited": { "$value": "{color.purple.300}", "$type": "color" },
        "disabled": { "$value": "{color.neutral.600}", "$type": "color" }
      },
      "danger": { "$value": "{color.red.300}", "$type": "color" },
      "success": { "$value": "{color.green.300}", "$type": "color" },
      "warning": { "$value": "{color.yellow.300}", "$type": "color" },
      "info": { "$value": "{color.blue.300}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.neutral.700}", "$type": "color" },
      "subtle": { "$value": "{color.neutral.800}", "$type": "color" },
      "primary": { "$value": "{color.blue.500}", "$type": "color" },
      "danger": { "$value": "{color.red.500}", "$type": "color" }
    }
  },
  "elevation": {
    "subtle": {
      "$type": "shadow",
      "$value": {
        "color": "{color.neutral.950}",
        "offsetX": "{shadow.x.0}",
        "offsetY": "{shadow.y.100}",
        "blur": "{shadow.blur.200}",
        "spread": "{shadow.spread.0}"
      }
    },
    "default": {
      "$type": "shadow",
      "$value": {
        "color": "{color.neutral.950}",
        "offsetX": "{shadow.x.0}",
        "offsetY": "{shadow.y.300}",
        "blur": "{shadow.blur.400}",
        "spread": "{shadow.spread.100}"
      }
    }
  }
}
