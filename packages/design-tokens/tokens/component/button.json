{
  "button": {
    "border-radius": { "$value": "{radius.default}", "$type": "dimension" },
    "border-width": { "$value": "{border.default}", "$type": "dimension" },
    "font-weight": { "$value": "{typography.font-weight.medium}", "$type": "fontWeight" },
    "line-height": { "$value": "{typography.line-height.snug}", "$type": "number" },
    "duration": { "$value": "{animation.default}", "$type": "duration" },

    "sm": {
      "padding-block": { "$value": "{spacing.100}", "$type": "dimension" },
      "padding-inline": { "$value": "{spacing.300}", "$type": "dimension" },
      "gap": { "$value": "{spacing.100}", "$type": "dimension" },
      "font-size": { "$value": "{typography.font-size.100}", "$type": "dimension" }
    },
    "md": {
      "padding-block": { "$value": "{spacing.200}", "$type": "dimension" },
      "padding-inline": { "$value": "{spacing.400}", "$type": "dimension" },
      "gap": { "$value": "{spacing.200}", "$type": "dimension" },
      "font-size": { "$value": "{typography.font-size.200}", "$type": "dimension" }
    },
    "lg": {
      "padding-block": { "$value": "{spacing.300}", "$type": "dimension" },
      "padding-inline": { "$value": "{spacing.500}", "$type": "dimension" },
      "gap": { "$value": "{spacing.200}", "$type": "dimension" },
      "font-size": { "$value": "{typography.font-size.300}", "$type": "dimension" }
    },

    "primary": {
      "color": {
        "background": {
          "rest": { "$value": "{color.background.primary.rest}", "$type": "color" },
          "hover": { "$value": "{color.background.primary.hover}", "$type": "color" },
          "active": { "$value": "{color.background.primary.active}", "$type": "color" },
          "disabled": { "$value": "{color.background.primary.disabled}", "$type": "color" }
        },
        "content": {
          "rest": {
            "$value": "{color.neutral.50}",
            "$type": "color",
            "$description": "Reaches past the semantic tier to a primitive: the role vocabulary has no inverse/on-color role for text on a filled surface. See docs/nomenclature.md § Known gaps."
          },
          "disabled": { "$value": "{color.content.subtle}", "$type": "color" }
        },
        "border": {
          "rest": { "$value": "{color.transparent}", "$type": "color" },
          "disabled": { "$value": "{color.transparent}", "$type": "color" }
        }
      }
    },

    "secondary": {
      "color": {
        "background": {
          "rest": { "$value": "{color.background.secondary.rest}", "$type": "color" },
          "hover": { "$value": "{color.background.secondary.hover}", "$type": "color" },
          "active": { "$value": "{color.background.secondary.active}", "$type": "color" },
          "disabled": { "$value": "{color.background.secondary.disabled}", "$type": "color" }
        },
        "content": {
          "rest": { "$value": "{color.content.default}", "$type": "color" },
          "disabled": { "$value": "{color.content.subtle}", "$type": "color" }
        },
        "border": {
          "rest": { "$value": "{color.border.default}", "$type": "color" },
          "disabled": { "$value": "{color.border.subtle}", "$type": "color" }
        }
      }
    },

    "ghost": {
      "color": {
        "background": {
          "rest": { "$value": "{color.transparent}", "$type": "color" },
          "hover": { "$value": "{color.background.secondary.hover}", "$type": "color" },
          "active": { "$value": "{color.background.secondary.active}", "$type": "color" },
          "disabled": { "$value": "{color.transparent}", "$type": "color" }
        },
        "content": {
          "rest": { "$value": "{color.content.primary.rest}", "$type": "color" },
          "disabled": { "$value": "{color.content.primary.disabled}", "$type": "color" }
        },
        "border": {
          "rest": { "$value": "{color.transparent}", "$type": "color" },
          "disabled": { "$value": "{color.transparent}", "$type": "color" }
        }
      }
    },

    "danger": {
      "color": {
        "background": {
          "rest": { "$value": "{color.background.danger.rest}", "$type": "color" },
          "hover": { "$value": "{color.background.danger.hover}", "$type": "color" },
          "active": { "$value": "{color.background.danger.active}", "$type": "color" },
          "disabled": { "$value": "{color.background.danger.disabled}", "$type": "color" }
        },
        "content": {
          "rest": { "$value": "{color.neutral.50}", "$type": "color" },
          "disabled": { "$value": "{color.content.subtle}", "$type": "color" }
        },
        "border": {
          "rest": { "$value": "{color.transparent}", "$type": "color" },
          "disabled": { "$value": "{color.transparent}", "$type": "color" }
        }
      }
    }
  }
}
