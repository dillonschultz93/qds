{
  "typography": {
    "font-family": {
      "sans": {
        "$value": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
        "$type": "fontFamily"
      },
      "serif": { "$value": "Georgia, Cambria, 'Times New Roman', serif", "$type": "fontFamily" },
      "mono": {
        "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
        "$type": "fontFamily"
      }
    },
    "font-size": {
      "100": { "$value": "0.75rem", "$type": "dimension" },
      "200": { "$value": "0.875rem", "$type": "dimension" },
      "300": { "$value": "1rem", "$type": "dimension" },
      "400": { "$value": "1.125rem", "$type": "dimension" },
      "500": { "$value": "1.25rem", "$type": "dimension" },
      "600": { "$value": "1.5rem", "$type": "dimension" },
      "700": { "$value": "1.875rem", "$type": "dimension" },
      "800": { "$value": "2.25rem", "$type": "dimension" },
      "900": { "$value": "3rem", "$type": "dimension" }
    },
    "font-weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "line-height": {
      "tight": { "$value": 1.2, "$type": "number" },
      "snug": { "$value": 1.375, "$type": "number" },
      "normal": { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.75, "$type": "number" }
    },
    "letter-spacing": {
      "tight": { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0em", "$type": "dimension" },
      "wide": { "$value": "0.04em", "$type": "dimension" }
    },
    "text-transform": {
      "none": { "$value": "none", "$type": "other" },
      "uppercase": { "$value": "uppercase", "$type": "other" }
    }
  }
}
