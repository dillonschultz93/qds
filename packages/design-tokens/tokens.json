        "serif": {
          "$value": "Georgia, Cambria, 'Times New Roman', serif",
          "$type": "fontFamily"
        },
        "mono": {
          "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
          "$type": "fontFamily"
        }
      },
      "font-size": {
        "100": {
          "$value": "0.75rem",
