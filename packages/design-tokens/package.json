{
  "name": "@quieto/design-tokens",
  "version": "0.2.0",
  "description": "Three-tier design tokens as CSS custom properties and a typed JS manifest, with light and dark modes.",
  "type": "module",
  "license": "MIT",
  "author": "Dillon Schultz",
  "homepage": "https://github.com/dillonschultz93/qds/tree/main/packages/design-tokens#readme",
  "bugs": "https://github.com/dillonschultz93/qds/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dillonschultz93/qds.git",
    "directory": "packages/design-tokens"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "dtcg",
    "css-variables",
    "dark-mode",
    "style-dictionary",
    "tokens-studio"
  ],
  "main": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "typesVersions": {
    "*": {
      "nomenclature": [
        "./dist/types/nomenclature.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "default": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/qds.css",
    "./css/light": "./dist/css/qds.light.css",
    "./css/dark": "./dist/css/qds.dark.css",
    "./nomenclature": {
      "types": "./dist/types/nomenclature.d.ts",
      "default": "./nomenclature.js"
    },
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens.json",
    "nomenclature.js",
    "docs/nomenclature.md",
    "docs/anatomy/*.svg",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/css/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "validate": "node validate.js",
    "docs:anatomy": "node docs/anatomy/generate.js",
    "build": "node docs/anatomy/generate.js && node build.js && tsc nomenclature.js --allowJs --declaration --emitDeclarationOnly --skipLibCheck --outDir dist/types",
    "prepack": "node validate.js && npm run build",
    "dev": "node build.js --watch",
    "test": "node --test",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "style-dictionary": "^5.5.0",
    "typescript": "5.9.3"
  }
}
